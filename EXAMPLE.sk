# This is a comment
# Skript syntax examples

options:
    prefix: &7[&bScript&7]
    permission message: &cYou don't have permission!

# Simple command
command /hello <player>:
    description: Say hello to a player
    usage: /hello <player>
    permission: hello.cmd
    trigger:
        message "Hello %arg 1%!"
        give arg 1 a diamond

# Event handler
on player join:
    message "Welcome %player%!"
    set {join_time::%player%} to now

# Variables
on player quit:
    delete {join_time::%player%}

# Function definition
function greet(p: player) :: text:
    return "Hello %{p}%!"

# Conditional
on damage of player:
    if attacker is a zombie:
        cancel event
        broadcast "%victim% was protected from %attacker%!"

# Loop
command /give_all <item>:
    trigger:
        loop all online players:
            give loop-player arg 1

# While loop
command /countdown <number>:
    trigger:
        set {counter} to arg 1
        while {counter} > 0:
            message {counter}
            subtract 1 from {counter}
            wait 1 second

# String interpolation
command /test:
    trigger:
        set {name} to "World"
        message "Hello %{name}%!"

# Type casting
on right click on block:
    set {block} to clicked block
    if {block} is a stone:
        message "You clicked stone!"

# Complex expressions
command /math <number> <number>:
    trigger:
        set {result} to arg 1 + arg 2
        message "%arg 1% + %arg 2% = %{result}%"

# List operations
command /additem:
    trigger:
        add "sword" to {inventory::%player%::*}
        message "Items: %{inventory::%player%::*}%"
